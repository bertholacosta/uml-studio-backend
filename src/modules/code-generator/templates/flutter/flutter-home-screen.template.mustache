{{#hasAuth}}
import '../api.dart';
{{/hasAuth}}
import '../assistant/assistant_screen.dart';
import '../config.dart';
import '../schema.dart';
import 'records_screen.dart';

/// Inicio: una fila por cada clase del diagrama y el acceso al asistente.
class HomeScreen extends StatelessWidget {
  const HomeScreen({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text(appName),
{{#hasAuth}}
        actions: [
          IconButton(
            tooltip: 'Cerrar sesión',
            icon: const Icon(Icons.logout),
            onPressed: Api.instance.logout,
          ),
        ],
{{/hasAuth}}
      ),
      body: ListView.separated(
        padding: const EdgeInsets.only(bottom: 88),
        itemCount: entities.length,
        separatorBuilder: (context, index) => const Divider(height: 1),
        itemBuilder: (context, index) {
          final entity = entities[index];
          return ListTile(
            leading: const Icon(Icons.table_rows_outlined),
            title: Text(entity.name),
            subtitle: Text('${entity.editable.length} campos'),
            trailing: const Icon(Icons.chevron_right),
            onTap: () => Navigator.push(
              context,
              MaterialPageRoute<void>(builder: (context) => RecordsScreen(entity: entity)),
            ),
          );
        },
      ),
      floatingActionButton: FloatingActionButton.extended(
        icon: const Icon(Icons.auto_awesome),
        label: const Text('Asistente'),
        onPressed: () => Navigator.push(
          context,
          MaterialPageRoute<void>(builder: (context) => const AssistantScreen()),
        ),
      ),
    );
  }
}
