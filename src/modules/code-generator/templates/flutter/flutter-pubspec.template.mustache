name: {{appName}}
description: "App Flutter generada a partir de un diagrama UML: CRUD genérico y asistente de IA local"
publish_to: 'none'
version: 1.0.0+1

environment:
  sdk: '>=3.0.0 <4.0.0'

dependencies:
  flutter:
    sdk: flutter

  # API REST del backend
  dio: ^5.11.1
{{#hasAuth}}

  # Sesión guardada entre un uso y otro
  shared_preferences: ^2.5.6
{{/hasAuth}}

  # Asistente: modelo de lenguaje en el dispositivo (Qwen2.5 con llama.cpp)
  lib_llama_cpp: ^0.7.5
  path_provider: ^2.1.6

  # Asistente: dictado por voz
  speech_to_text: ^7.5.0

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^6.0.0

flutter:
  uses-material-design: true
