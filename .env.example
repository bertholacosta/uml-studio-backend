# Copia este archivo como .env y rellena los valores.
# Los valores de abajo sirven para desarrollo local; las líneas comentadas son opcionales.

# ---------- Servidor ----------
PORT=4000
NODE_ENV=development
# Orígenes del frontend separados por comas (en desarrollo ya se admite http://localhost:4200)
CORS_ORIGINS=http://localhost:4200
# Tamaño máximo del cuerpo JSON; las fotos para Trazo viajan en Base64
# BODY_LIMIT=15mb
# Publicar Swagger en /api/docs también en producción
# SWAGGER_ENABLED=true

# ---------- Base de datos PostgreSQL ----------
# Usa DATABASE_URL o las variables sueltas; si existe DATABASE_URL tiene prioridad
# DATABASE_URL=postgres://usuario:password@host:5432/uml_studio_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=tu_password
DB_NAME=uml_studio_db
# true crea o ajusta las tablas al arrancar (solo desarrollo); si no, ejecuta schema.sql
DB_SYNCHRONIZE=false
DB_LOGGING=false
# TLS para Postgres gestionados en la nube
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false
# DB_POOL_SIZE=10

# ---------- Autenticación ----------
# Secreto largo y aleatorio (obligatorio en producción)
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# ---------- MongoDB: conversación compartida con Trazo y su contexto ----------
MONGODB_URI=mongodb://localhost:27017/uml_studio_ai

# ---------- Asistente Trazo: modelo local con Ollama ----------
# ollama, bedrock o gemini (por defecto ollama)
AI_PROVIDER=ollama
# Servidor Ollama: este equipo, la URL de Modal (ollama/modal_app.py), un servidor propio o Colab
OLLAMA_BASE_URL=http://localhost:11434
# Modelo propio creado con: ollama create trazo -f ollama/Modelfile
OLLAMA_MODEL=trazo
# Modelo local con visión para las fotos de diagramas (si no, usa AI_VISION_PROVIDER=gemini)
# OLLAMA_VISION_MODEL=qwen2.5vl:7b
# Tokens de proxy de Modal (Settings → Proxy Auth Tokens), obligatorios si el servidor es Modal
# MODAL_KEY=wk-...
# MODAL_SECRET=ws-...
# Token si el servidor Ollama está detrás de un proxy propio con autenticación
# OLLAMA_API_KEY=
# Ventana de contexto y tiempo que el modelo queda cargado en la GPU entre preguntas
# OLLAMA_NUM_CTX=8192
# OLLAMA_KEEP_ALIVE=30m
# Modelos con razonamiento (qwen3): false responde más rápido
# OLLAMA_THINK=false
# Proveedor de las imágenes; por defecto, el mismo que AI_PROVIDER
AI_VISION_PROVIDER=gemini

# ---------- Amazon Bedrock (AI_PROVIDER=bedrock) ----------
# Modelo abierto de Bedrock (aws bedrock list-foundation-models --by-provider qwen)
# BEDROCK_MODEL_ID=qwen.qwen3-32b-v1:0
# BEDROCK_REGION=us-east-1
# Clave de API de Bedrock (consola de Bedrock → API keys); en la EC2 se usa el rol de la instancia
# AWS_BEARER_TOKEN_BEDROCK=

# ---------- Google Gemini (imágenes, o todo si AI_PROVIDER=gemini) ----------
# Clave de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_api_key_de_google_ai_studio
GEMINI_MODEL=gemini-3.8-flash
# Modelo al que pasar si el principal sigue saturado tras los reintentos
# GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# Tiempo máximo de espera por respuesta del modelo, en milisegundos
# AI_TIMEOUT_MS=45000
# Usar Vertex AI de Google Cloud en lugar de AI Studio
# GEMINI_USE_VERTEX=true
# GCP_PROJECT_ID=tu_proyecto_de_gcp
# GCP_LOCATION=us-central1
