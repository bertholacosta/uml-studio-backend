{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      "**/*.mustache",
      {
        "include": "**/gradle-wrapper/*",
        "watchAssets": false
      }
    ]
  }
}
